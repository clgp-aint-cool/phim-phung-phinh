# Copy file này thành ".env" (cùng thư mục docker-compose.yml) rồi điền key.
# Lấy key miễn phí: themoviedb.org -> Settings -> API
# Dùng được "API Key" (v3) hoặc "API Read Access Token" (v4, chuỗi dài bắt đầu bằng eyJ)
TMDB_API_KEY=

# Chu kỳ cập nhật Top 10 (giờ)
TOP_INTERVAL_HOURS=6

# Chu kỳ quét toàn bộ KKPhim để sắp xếp theo đánh giá/độ phổ biến (giờ)
CATALOG_INTERVAL_HOURS=24
